# ---- SDS POC shared configuration (copy to .env; .env is git-ignored) ----
# Provider: mock (no real OpenAI client is created) | openai (fails fast when settings are missing)
EXTRACTION_PROVIDER=mock

# OpenAI (only read when EXTRACTION_PROVIDER=openai). Model names are NOT guessed by code.
OPENAI_API_KEY=
OPENAI_MODEL_BASELINE=
OPENAI_MODEL_CANDIDATE=
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_ATTEMPTS=2
# Optional: detail level for PDF input_file (auto|low|high). Empty = not sent, recorded as "default".
OPENAI_FILE_DETAIL=
OPENAI_MAX_OUTPUT_TOKENS=8192

# Upload / processing limits
MAX_UPLOAD_BYTES=20971520
PROCESSING_LEASE_SECONDS=600
MIN_TEXT_CHARS_PER_PAGE=40

# Storage (Azurite by default)
AzureWebJobsStorage=UseDevelopmentStorage=true
SDS_BLOB_CONTAINER=sds
SDS_QUEUE_NAME=sds-jobs

# Auth: local_dev (loopback only, refused on Azure) | easyauth (App Service Authentication headers)
AUTH_MODE=local_dev
LOCAL_DEV_USER_ID=local-dev-user
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Directory holding the user's own PDF/DOCX test documents (never committed, no samples generated)
TEST_SDS_DIR=

# Optional phase-6 adapter endpoint (not used in phase 1)
DOCINTEL_ENDPOINT=

# Frontend
API_BASE_URL=http://localhost:7071/api
SDS_TABLE_PREFIX=sds
